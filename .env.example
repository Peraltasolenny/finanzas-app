# Copia este archivo como ".env" y rellena los valores reales.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Clave secreta para firmar las sesiones. Genera una así (en la terminal):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Base de datos.
# En LOCAL puedes dejar esto vacío: usará un archivo SQLite automáticamente.
# En PRODUCCIÓN (Render) pega aquí la cadena de conexión de Neon Postgres.
DATABASE_URL=

# Símbolo de moneda (opcional). Por defecto RD$.
CURRENCY=RD$

# Marca production en Render para activar cookies seguras (https).
# En local déjalo vacío.
FLASK_ENV=
